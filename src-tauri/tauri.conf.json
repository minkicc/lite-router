{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MKSwitch",
  "version": "1.1.1",
  "identifier": "cc.minki.mkswitch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MKSwitch",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mkswitch"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
