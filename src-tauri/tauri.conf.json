{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lite Router",
  "version": "1.0.4",
  "identifier": "cc.minki.literouter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lite Router",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/lite-router"
    ]
  }
}
